# ProteinHouse Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Local dev:  copy to .env.local and fill in
# Netlify:    Site configuration → Environment variables → Add variable
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Option A: Supabase Cloud (recommended — free tier at https://supabase.com)
#   Project Settings → API → Project URL + anon/public key
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Option B: Self-hosted on EC2 (if you keep EC2)
# VITE_SUPABASE_URL=https://api.proteinhouse.ba
# VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Analitika (GA4 preko Google Tag Managera) ────────────────────────────────
# GTM se učitava tek nakon što korisnik prihvati kolačiće (cookie consent).
# GA4 tag se konfiguriše unutar GTM containera.
VITE_GTM_ID=GTM-XXXXXXX

# ── AI generator opisa proizvoda (Admin → Proizvodi → uredi) ─────────────────
# Poziva Claude (Sonnet) preko AWS Bedrocka. Server-only — NIKAD VITE_ prefiks
# (ovi ključevi se ne smiju naći u browser bundleu).
#
# Podešavanje:
#   1. AWS Bedrock Console → Model access → uključi pristup Claude Sonnet modelu
#      za odabrani region (ako je isključen, poziv vraća AccessDeniedException).
#   2. Kreiraj IAM korisnika s dozvolom samo: bedrock:InvokeModel (na model ARN).
#   3. Namjerno NE koristimo standardne AWS_* nazive — Netlify funkcije (i AWS
#      Lambda generalno) same postavljaju AWS_ACCESS_KEY_ID/AWS_REGION za svoj
#      izvršni kontekst, bez Bedrock pristupa; standardni nazivi bi se sudarili.
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_REGION=eu-central-1
# Provjeri tačan ID u Bedrock Console → Model catalog (cesto trazi "inference
# profile" ID s prefiksom regiona, npr. us./eu., ne goli model ID).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── Express server (local dev + EC2 only — not used on Netlify) ──────────────
PORT=3000
NODE_ENV=development
BASE=/
