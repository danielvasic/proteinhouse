# ProteinHouse Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Local dev:  copy to .env.local and fill in
# Netlify:    Site configuration → Environment variables → Add variable
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Option A: Supabase Cloud (recommended — free tier at https://supabase.com)
#   Project Settings → API → Project URL + anon/public key
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Option B: Self-hosted on EC2 (if you keep EC2)
# VITE_SUPABASE_URL=https://api.proteinhouse.ba
# VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Analitika (GA4 preko Google Tag Managera) ────────────────────────────────
# GTM se učitava tek nakon što korisnik prihvati kolačiće (cookie consent).
# GA4 tag se konfiguriše unutar GTM containera.
VITE_GTM_ID=GTM-XXXXXXX

# ── AI generator opisa proizvoda (Admin → Proizvodi → uredi) ─────────────────
# Poziva Claude (Sonnet) preko AWS Bedrocka. Server-only — NIKAD VITE_ prefiks
# (ovi ključevi se ne smiju naći u browser bundleu).
#
# Podešavanje:
#   1. AWS Bedrock Console → Model access → uključi pristup odabranom Claude
#      modelu za tvoj region (ako je isključen, poziv vraća AccessDeniedException).
#   2. Kreiraj IAM korisnika s dozvolom samo: bedrock:InvokeModel (na model ARN).
#   3. Namjerno NE koristimo standardne AWS_* nazive — Netlify funkcije (i AWS
#      Lambda generalno) same postavljaju AWS_ACCESS_KEY_ID/AWS_REGION za svoj
#      izvršni kontekst, bez Bedrock pristupa; standardni nazivi bi se sudarili.
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_REGION=eu-north-1
# Model ID prihvata i puni inference-profile ARN (ne samo goli model ID) —
# pronađi ga u Bedrock Console → Cross-region inference → tvoj profil.
# Primjer formata (zamijeni <ACCOUNT_ID> svojim brojem naloga):
# BEDROCK_MODEL_ID=arn:aws:bedrock:eu-north-1:<ACCOUNT_ID>:inference-profile/eu.anthropic.claude-opus-5
BEDROCK_MODEL_ID=

# ── Email podsjetnik nakon 25 dana (netlify/functions/reminder-emails.mjs) ───
# Scheduled funkcija se vrti jednom dnevno, nađe narudžbe starije od 25 dana
# bez poslanog podsjetnika i pošalje kupcu kupon za sljedeću kupovinu.
# Sve server-only — bez VITE_ prefiksa.
#
# service_role ključ: Supabase → Project Settings → API → service_role.
# Zaobilazi RLS, pa smije živjeti SAMO u Netlify env varijablama.
SUPABASE_SERVICE_ROLE_KEY=
# Resend: https://resend.com → API Keys. Domenu proteinhouse.ba treba verifikovati
# (DNS zapisi) prije nego se smije slati s te adrese.
RESEND_API_KEY=
RESEND_FROM=ProteinHouse <info@proteinhouse.ba>
# Kupon koji ide u podsjetnik — mora postojati i biti aktivan u Admin → Kuponi.
REMINDER_COUPON=POPUST5
SITE_URL=https://proteinhouse.ba

# ── Viber podsjetnik (BulkGate Business Messages, src/server/viber.js) ──────
# Ista dnevna funkcija kao email: 25 dana nakon narudzbe, samo kupcima koji su
# na checkoutu dali privolu (orders.viber_consent_at). Bez ova tri kljuca grana
# radi u dry-run modu — broji koga bi pogodila, nista ne salje.
# Portal: https://portal.bulkgate.com → Modules & APIs → Advanced transactional API.
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
# Registrovani Viber sender (odobrenje traje ~14 dana uz dokumente firme).
BULKGATE_VIBER_SENDER=ProteinHouse
# Tajna u URL-u webhooka (BulkGate ne potpisuje zahtjeve). Isti niz upisi u
# Portal → Webhook kao https://new.proteinhouse.ba/api/viber-webhook?token=<ovo>.
BULKGATE_WEBHOOK_TOKEN=
# Opcionalno; default je promotivni v2 endpoint (transakcijski zabranjuje marketing).
# BULKGATE_ENDPOINT=https://portal.bulkgate.com/api/2.0/advanced/promotional

# ── Express server (local dev + EC2 only — not used on Netlify) ──────────────
PORT=3000
NODE_ENV=development
BASE=/

# ── Sinhronizacija s ERP-om (netlify/functions/erp-sync.mjs) ─────────────────
# Scheduled funkcija se vrti svaki sat: povlači sve artikle s
# proteinhouse-api.work u erp_articles (sirovo ogledalo) i osvježava cijene u
# katalogu. Novi artikli ulaze kao NEAKTIVNI nacrti — ERP šalje isWeb=false na
# svim artiklima pa se iz podataka ne može zaključiti šta smije na web.
#
# Koristi isti SUPABASE_SERVICE_ROLE_KEY kao email podsjetnik (gore).
# ERP API je javan i ne traži ključ, pa nema dodatnih varijabli.

# ── ERP API (katalog i stanje skladišta) ────────────────────────────────────
# Stari API (proteinhouse-api.work) vraćen je jer o njemu ovisi STARA stranica
# dok nova ne krene; novi API je preseljen na drugi host. Zato su izvori
# odvojivi — sync bira endpoint po tome što stvarno vrati, pa isti kod radi
# s oba API-ja i mijenja se samo adresa.
#
# Katalog. Prazno = stari API.
ERP_API_BASE=
# Stanje skladišta (GetArtikliSaStanjem). Prazno = isti host kao katalog.
# Postavi kad stigne adresa novog API-ja — stari nema endpoint za lager.
ERP_STOCK_API_BASE=
